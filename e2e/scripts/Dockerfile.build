ARG CODENAME=latest
FROM ubuntu:$CODENAME

ARG DEBIAN_FRONTEND=noninteractive

RUN sed -i -- 's/# deb-src/deb-src/g' /etc/apt/sources.list
RUN echo 'man-db man-db/auto-update boolean false' | debconf-set-selections

RUN set -ex \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends

ARG CODENAME=latest

# Keep the codename list easy to maintain, keeping in mind that we might need to
# add more as the need to backport various packages arises.
#
# Noble and Resolute need the Go 1.27 backport from
# ppa:ubuntu-enterprise-desktop/golang. Their release patches select it
# explicitly instead of the older default golang-go package.
RUN if [ "$CODENAME" = "noble" ] || [ "$CODENAME" = "resolute" ]; then \
        set -ex \
        && apt-get install -y software-properties-common \
        && ok=0 \
        && delay=15 \
        && for i in 1 2 3 4 5 6; do \
               if add-apt-repository -y ppa:ubuntu-enterprise-desktop/golang; then ok=1; break; fi; \
               echo "Adding the golang PPA failed, retrying in ${delay}s (attempt $i/6)"; \
               sleep "$delay"; \
               delay=$((delay * 2)); \
               if [ "$delay" -gt 120 ]; then delay=120; fi; \
           done \
        && [ "$ok" = 1 ]; \
    fi

RUN set -ex \
    && apt-get install -y --no-install-recommends \
               build-essential \
               cdbs \
               devscripts \
               equivs \
               fakeroot \
    && apt-mark minimize-manual -y \
    && apt-get autopurge -y \
    && apt-get clean
RUN rm /etc/apt/apt.conf.d/docker-clean
RUN rm -rf /tmp/* /var/tmp/
RUN ln -s /tmp /var/tmp
